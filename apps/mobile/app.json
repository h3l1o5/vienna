{
  "expo": {
    "name": "Vienna",
    "slug": "vienna",
    "version": "1.0.0",
    "platforms": ["ios"],
    "orientation": "portrait",
    "scheme": "vienna",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/vienna.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.h3l1o5.vienna"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf9f6",
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#161514",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
